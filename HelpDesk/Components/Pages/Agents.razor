@page "/agents"
@using HelpDesk.Application.Agents
@inject ILogger<Agents> Logger

<PageTitle>Agent Pipeline Orchestrator (Demo)</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-12">
            <h1 class="mb-4">
                <i class="bi bi-robot"></i> Agent Pipeline Orchestrator (Demo)
            </h1>

            <!-- Input Section -->
            <div class="card mb-4 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Launch Agent Pipeline</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="objective" class="form-label fw-bold">Objective</label>
                        <textarea
                            id="objective"
                            class="form-control"
                            rows="4"
                            placeholder="Enter your objective (e.g., 'Create a user management dashboard')"
                            @bind="Objective"
                            @bind:event="oninput"
                            disabled="@IsExecuting"></textarea>
                        <small class="text-muted">
                            Describe what you want the agents to design, code, and integrate.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label for="context" class="form-label fw-bold">Optional Context</label>
                        <textarea
                            id="context"
                            class="form-control"
                            rows="3"
                            placeholder="Additional context for the agents (optional)"
                            @bind="OptionalContext"
                            @bind:event="oninput"
                            disabled="@IsExecuting"></textarea>
                        <small class="text-muted">
                            Provide any additional context about requirements, constraints, or dependencies.
                        </small>
                    </div>

                    <button
                        class="btn btn-lg btn-primary me-2"
                        @onclick="ExecuteAsync"
                        disabled="@IsExecuting">
                        @if (IsExecuting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Running Pipeline...</span>
                        }
                        else
                        {
                            <span>🚀 Run Agent Pipeline</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">
                            <strong>Error:</strong> @ErrorMessage
                        </div>
                    }
                </div>
            </div>

            @if (Result != null)
            {
                <!-- Results Section -->
                <div class="card mb-4 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">✓ Demo Orchestration Results</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning" role="alert">
                            <h6 class="alert-heading mb-2">Demo Mode</h6>
                            <p class="mb-2">@DemoSummary</p>
                            <hr />
                            <p class="mb-1"><strong>Objective:</strong> @Objective</p>
                            <p class="mb-0"><strong>Optional Context:</strong> @(string.IsNullOrWhiteSpace(OptionalContext) ? "(none provided)" : OptionalContext)</p>
                        </div>

                        <div class="card mb-4 border-primary">
                            <div class="card-header bg-primary text-white">
                                <h6 class="mb-0">What would happen with real LLM wiring</h6>
                            </div>
                            <div class="card-body">
                                <ul class="mb-0">
                                    @foreach (var item in DemoWhatWouldHappen)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <!-- Objective Summary -->
                        <div class="alert alert-info" role="alert">
                            <strong>Objective:</strong> @Result.Objective
                        </div>

                        <!-- Planner Output -->
                        <div class="card mb-4 border-info">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0">📋 Planner Summary</h6>
                            </div>
                            <div class="card-body">
                                <p>@Result.Planner.Summary</p>

                                <h6 class="mt-3 mb-2">Planned Steps:</h6>
                                <div class="list-group">
                                    @foreach (var step in Result.Planner.Steps)
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex w-100 justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1">
                                                        <span class="badge bg-secondary">@step.Id</span>
                                                        @step.Description
                                                    </h6>
                                                    <small class="text-muted">
                                                        Assignee: <strong>@step.Assignee</strong>
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="mt-2">
                                                <small class="d-block text-muted mb-1">
                                                    <strong>Files:</strong>
                                                </small>
                                                <div class="ms-2">
                                                    @foreach (var file in step.Files)
                                                    {
                                                        <code class="d-block text-secondary">@file</code>
                                                    }
                                                </div>
                                            </div>
                                            @if (step.DependsOn?.Any() == true)
                                            {
                                                <div class="mt-2">
                                                    <small class="d-block text-muted">
                                                        <strong>Depends On:</strong> @string.Join(", ", step.DependsOn)
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (Result.Planner.EdgeCases.Any())
                                {
                                    <div class="mt-3">
                                        <h6 class="mb-2">Edge Cases:</h6>
                                        <ul class="mb-0">
                                            @foreach (var edge in Result.Planner.EdgeCases)
                                            {
                                                <li>@edge</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (Result.Planner.OpenQuestions.Any())
                                {
                                    <div class="mt-3">
                                        <h6 class="mb-2">Open Questions:</h6>
                                        <ul class="mb-0">
                                            @foreach (var question in Result.Planner.OpenQuestions)
                                            {
                                                <li>@question</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Execution Phases -->
                        <div class="card mb-4 border-warning">
                            <div class="card-header bg-warning text-dark">
                                <h6 class="mb-0">⚙️ Execution Phases (@Result.Phases.Count)</h6>
                            </div>
                            <div class="card-body">
                                @foreach (var phase in Result.Phases)
                                {
                                    <div class="mb-3 p-3 bg-light border rounded">
                                        <h6 class="mb-2">
                                            Phase @phase.Number
                                            <span class="badge @(phase.RunsInParallel ? "bg-success" : "bg-secondary")">
                                                @(phase.RunsInParallel ? "Parallel" : "Sequential")
                                            </span>
                                        </h6>
                                        <div class="row">
                                            @foreach (var task in phase.Tasks)
                                            {
                                                <div class="col-12">
                                                    <small class="d-block text-muted">
                                                        <strong>@task.Id:</strong> @task.Description (@task.Assignee)
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Designer Output -->
                        @if (DemoDesignerOutput is not null)
                        {
                            <div class="card mb-4 border-success">
                                <div class="card-header bg-success text-white">
                                    <h6 class="mb-0">🎨 DesignerOutput</h6>
                                </div>
                                <div class="card-body">
                                    <p><strong>Summary:</strong> @DemoDesignerOutput.Summary</p>

                                    <h6 class="mt-3 mb-2">UI Components</h6>
                                    <ul>
                                        @foreach (var component in DemoDesignerOutput.Components)
                                        {
                                            <li><strong>@component.Name</strong> - dependencies: @string.Join(", ", component.Dependencies)</li>
                                        }
                                    </ul>

                                    @if (DemoDesignerOutput.InteractionPatterns.Any())
                                    {
                                        <h6 class="mt-3 mb-2">Interaction Patterns</h6>
                                        <ul>
                                            @foreach (var pattern in DemoDesignerOutput.InteractionPatterns)
                                            {
                                                <li>@pattern</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Coder Output -->
                        @if (DemoCoderOutput is not null)
                        {
                            <div class="card mb-4 border-success">
                                <div class="card-header bg-success text-white">
                                    <h6 class="mb-0">💻 CoderOutput</h6>
                                </div>
                                <div class="card-body">
                                    <p><strong>Summary:</strong> @DemoCoderOutput.Summary</p>

                                    <h6 class="mt-3 mb-2">Code Scaffolding Preview</h6>
                                    <ul>
                                        @foreach (var change in DemoCoderOutput.Changes)
                                        {
                                            <li><strong>@change.FilePath</strong> - @change.Description</li>
                                        }
                                    </ul>

                                    @if (DemoCoderOutput.Warnings.Any())
                                    {
                                        <h6 class="mt-3 mb-2">Notes</h6>
                                        <ul>
                                            @foreach (var warning in DemoCoderOutput.Warnings)
                                            {
                                                <li>@warning</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Specialist Outputs -->
                        <div class="card mb-4 border-success">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0">✓ Agent Outputs (@Result.Outputs.Count)</h6>
                            </div>
                            <div class="card-body">
                                @foreach (var response in Result.Outputs)
                                {
                                    <div class="mb-3 p-3 bg-light border rounded">
                                        <h6 class="mb-2">
                                            <span class="badge bg-primary">@response.Role</span>
                                            <span class="badge bg-secondary">@(response.TaskId ?? "N/A")</span>
                                        </h6>
                                        <p class="mb-2">
                                            <strong>Output:</strong> @response.Output
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Audit Trail -->
                        <div class="card border-secondary">
                            <div class="card-header bg-secondary text-white">
                                <h6 class="mb-0">📊 Audit Trail (@Result.AuditTrail.Count events)</h6>
                            </div>
                            <div class="card-body">
                                <div class="list-group list-group-flush">
                                    @foreach (var entry in Result.AuditTrail)
                                    {
                                        <div class="list-group-item px-0">
                                            <div class="d-flex w-100 justify-content-between">
                                                <small class="text-muted">
                                                    <strong>@entry.TimestampUtc:G</strong>
                                                </small>
                                            </div>
                                            <p class="mb-0 mt-1">@entry.Message</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Full Report -->
                        <div class="card mt-4 border-dark">
                            <div class="card-header bg-dark text-white">
                                <h6 class="mb-0">📄 Complete Report</h6>
                            </div>
                            <div class="card-body">
                                <pre class="bg-light p-3 rounded overflow-auto" style="max-height: 500px;">@Result.Report</pre>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string Objective = string.Empty;
    private string OptionalContext = string.Empty;
    private OrchestrationResult? Result;
    private DesignerOutput? DemoDesignerOutput;
    private CoderOutput? DemoCoderOutput;
    private bool IsExecuting;
    private string ErrorMessage = string.Empty;
    private string DemoSummary = string.Empty;
    private IReadOnlyList<string> DemoWhatWouldHappen = [];

    private async Task ExecuteAsync()
    {
        ErrorMessage = string.Empty;
        Result = null;
        DemoDesignerOutput = null;
        DemoCoderOutput = null;
        IsExecuting = true;

        try
        {
            if (string.IsNullOrWhiteSpace(Objective))
            {
                ErrorMessage = "Please enter an objective before running the pipeline.";
                return;
            }

            var plannerOutput = new PlannerOutput(
                Summary: "Demo planner output generated locally in the UI.",
                Steps:
                [
                    new("step-1", AgentRole.Planner, "Analyze objective and break it into delivery milestones.", ["PRD.md"]),
                    new("step-2", AgentRole.Designer, "Propose Blazor component layout and user flow.", ["Components/Pages/Agents.razor"], ["step-1"]),
                    new("step-3", AgentRole.Coder, "Scaffold application/service contracts and integration points.", ["Application/"], ["step-1", "step-2"])
                ],
                EdgeCases:
                [
                    "Missing objective details can lead to ambiguous plans.",
                    "Conflicting constraints may require trade-off decisions."
                ],
                OpenQuestions:
                [
                    "Should generated code prioritize speed or extensibility first?"
                ]);

            DemoDesignerOutput = new DesignerOutput(
                Summary: "If wired to an LLM, the Designer agent would suggest page composition, UX hierarchy, and accessibility guidance.",
                Components:
                [
                    new("ObjectiveInputPanel", "<section>...</section>", ["Bootstrap form controls"]),
                    new("PipelineResultsPanel", "<section>...</section>", ["Cards", "Badges", "Alert components"])
                ],
                Styles: ["Consistent spacing scale", "Readable card hierarchy"],
                InteractionPatterns:
                [
                    "Guide users through objective entry before running pipeline.",
                    "Show progress and clearly separate planner/designer/coder result areas."
                ],
                AccessibilityConsiderations:
                [
                    "Use semantic headings and labels.",
                    "Provide status text for loading state and errors."
                ],
                RequiresUserTesting: true);

            DemoCoderOutput = new CoderOutput(
                Summary: "If wired to an LLM, the Coder agent would scaffold service calls, DTO mapping, and component state handling.",
                Changes:
                [
                    new("Application/Services/AgentsService.cs", "Scaffold service method signatures for kickoff and result mapping.", ["KickoffAsync", "error handling"]),
                    new("Components/Pages/Agents.razor", "Scaffold UI state transitions and rendering for each output section.", ["ExecuteAsync", "result cards"])
                ],
                TestCasesGenerated:
                [
                    "Objective is required before submit.",
                    "Demo output renders planner, designer, coder, and audit sections."
                ],
                Dependencies: ["System.Net.Http.Json"],
                Warnings:
                [
                    "Demo mode only: no backend pipeline or LLM call is executed.",
                    "No project files are modified by this action."
                ],
                RequiresReview: true);

            var audit = new List<AuditEntry>
            {
                new(DateTimeOffset.UtcNow, "Demo kickoff received from UI."),
                new(DateTimeOffset.UtcNow, "Demo PlannerOutput prepared locally."),
                new(DateTimeOffset.UtcNow, "Demo DesignerOutput prepared locally."),
                new(DateTimeOffset.UtcNow, "Demo CoderOutput prepared locally."),
                new(DateTimeOffset.UtcNow, "Demo pipeline completed. No backend agents were invoked.")
            };

            var outputs = new List<AgentResponse>
            {
                new(AgentRole.Planner, plannerOutput.Summary, plannerOutput.Steps.Select(s => s.Description).ToList(), "step-1", ["PRD.md"]),
                new(AgentRole.Designer, DemoDesignerOutput.Summary, DemoDesignerOutput.InteractionPatterns, "step-2", ["Components/Pages/Agents.razor"]),
                new(AgentRole.Coder, DemoCoderOutput.Summary, DemoCoderOutput.Changes.Select(c => c.Description).ToList(), "step-3", DemoCoderOutput.Changes.Select(c => c.FilePath).ToList())
            };

            DemoSummary = "This is a demonstration response. No real feature generation, no real code synthesis, and no file changes will occur.";
            DemoWhatWouldHappen =
            [
                "Planner agent would interpret your objective and create sequenced execution steps.",
                "Designer agent would propose Blazor page layout suggestions, interaction patterns, and accessibility checks.",
                "Coder agent would scaffold code structure, service contracts, and implementation tasks for developer review."
            ];

            var report = string.Join(Environment.NewLine,
            [
                "## Demo Agent Pipeline Result",
                $"Objective: {Objective}",
                $"Optional Context: {(string.IsNullOrWhiteSpace(OptionalContext) ? "(none provided)" : OptionalContext)}",
                string.Empty,
                "This is a UI-only demonstration. No backend or LLM execution was performed."
            ]);

            Result = new OrchestrationResult(
                Objective,
                plannerOutput,
                [new ExecutionPhase(1, plannerOutput.Steps, false, [])],
                outputs,
                audit,
                report);

            Logger.LogInformation("Demo pipeline response generated locally.");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            Logger.LogError(ex, "Error generating demo pipeline response: {Message}", ex.Message);
        }
        finally
        {
            IsExecuting = false;
        }

        await InvokeAsync(StateHasChanged);
    }
}
