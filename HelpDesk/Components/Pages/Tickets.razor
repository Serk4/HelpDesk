@page "/tickets"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using HelpDesk.Application.Security
@using HelpDesk.Application.Tickets
@using HelpDesk.Application.Users
@using HelpDesk.Domain.Tickets
@using Microsoft.AspNetCore.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITicketService TicketService
@inject IUserAdministrationService UserAdministrationService
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Tickets</PageTitle>

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Ticket List</h1>
            <p class="text-muted mb-0">Track requests, assignments, workflow state, and recent activity.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" @onclick="LoadPageAsync" disabled="@IsLoading">Refresh</button>
            <button type="button" class="btn btn-primary" @onclick="ToggleCreateForm" disabled="@IsCreating">
                @(ShowCreateForm ? "Cancel" : "Create Ticket")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <div class="text-muted small">Visible Tickets</div>
                    <div class="fs-4 fw-semibold">@Dashboard.TotalTickets</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-warning">
                <div class="card-body">
                    <div class="text-muted small">Open Work</div>
                    <div class="fs-4 fw-semibold">@Dashboard.OpenTickets</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <div class="text-muted small">My Requested</div>
                    <div class="fs-4 fw-semibold">@Dashboard.MyRequestedTickets</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-danger">
                <div class="card-body">
                    <div class="text-muted small">Critical</div>
                    <div class="fs-4 fw-semibold">@Dashboard.CriticalTickets</div>
                </div>
            </div>
        </div>
    </div>

    @if (ShowCreateForm)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">New Ticket</div>
            <div class="card-body">
                <EditForm Model="CreateModel" OnValidSubmit="CreateTicketAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Title</label>
                            <InputText class="form-control" @bind-Value="CreateModel.Title" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Category</label>
                            <InputSelect class="form-select" @bind-Value="CreateModel.CategoryId">
                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="5" @bind-Value="CreateModel.Description" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Priority</label>
                            <InputSelect class="form-select" @bind-Value="CreateModel.Priority">
                                @foreach (var priority in Enum.GetValues<TicketPriority>())
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success" disabled="@IsCreating">
                            @if (IsCreating)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>Create Ticket</span>
                            }
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleCreateForm" disabled="@IsCreating">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-lg-3 col-md-6">
                    <InputText class="form-control" @bind-Value="SearchText" placeholder="Search title or description" />
                </div>
                <div class="col-lg-2 col-md-6">
                    <InputSelect class="form-select" @bind-Value="SelectedCategoryId">
                        <option value="">All Categories</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category.Id.ToString()">@category.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-lg-2 col-md-6">
                    <InputSelect class="form-select" @bind-Value="SelectedStatus">
                        <option value="">All Statuses</option>
                        @foreach (var status in Enum.GetValues<TicketStatus>())
                        {
                            <option value="@status.ToString()">@status</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-lg-2 col-md-6">
                    <InputSelect class="form-select" @bind-Value="SelectedPriority">
                        <option value="">All Priorities</option>
                        @foreach (var priority in Enum.GetValues<TicketPriority>())
                        {
                            <option value="@priority.ToString()">@priority</option>
                        }
                    </InputSelect>
                </div>
                @if (CanManageAll)
                {
                    <div class="col-lg-3 col-md-6">
                        <InputSelect class="form-select" @bind-Value="SelectedAssigneeUserId">
                            <option value="">All Assignees</option>
                            <option value="__unassigned">Unassigned</option>
                            @foreach (var agent in AssignableAgents)
                            {
                                <option value="@agent.UserId">@agent.Email</option>
                            }
                        </InputSelect>
                    </div>
                }
                <div class="col-lg-2 col-md-6">
                    <InputDate class="form-control" @bind-Value="UpdatedFrom" />
                </div>
                <div class="col-lg-2 col-md-6">
                    <InputDate class="form-control" @bind-Value="UpdatedTo" />
                </div>
                <div class="col-lg-8 d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-primary" @onclick="ApplyFiltersAsync">Apply Filters</button>
                    <button class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">Clear</button>
                    <button class="btn btn-outline-info" @onclick="() => SetScopeAsync(TicketScope.MyRequested)">My Requested</button>
                    <button class="btn btn-outline-info" @onclick="() => SetScopeAsync(TicketScope.MyAssigned)">My Assigned</button>
                    @if (CanManageAll)
                    {
                        <button class="btn btn-outline-dark" @onclick="() => SetScopeAsync(TicketScope.All)">All Visible</button>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@SuccessMessage</div>
    }

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
            <span>Loading tickets...</span>
        </div>
    }
    else if (TicketItems.Count == 0)
    {
        <div class="alert alert-info" role="alert">No tickets found for the selected filters.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Requester</th>
                        <th>Assigned To</th>
                        <th>Last Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in TicketItems)
                    {
                        <tr style="cursor: pointer;" @onclick="() => NavigateToDetails(ticket.Id)">
                            <td>#@ticket.Id</td>
                            <td>
                                <div class="fw-semibold">@ticket.Title</div>
                                <div class="small text-muted">@Truncate(ticket.Description, 90)</div>
                            </td>
                            <td>@ticket.Category.Name</td>
                            <td><span class="badge @GetStatusBadgeClass(ticket.Status)">@ticket.Status</span></td>
                            <td><span class="badge @GetPriorityBadgeClass(ticket.Priority)">@ticket.Priority</span></td>
                            <td>@(IsAdmin ? ticket.RequesterUserId : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(ticket.AssignedUserId) ? "Unassigned" : ticket.AssignedUserId)</td>
                            <td>@ticket.UpdatedAt.ToLocalTime().ToString("g")</td>
                            <td class="text-end" @onclick:stopPropagation="true">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => NavigateToDetails(ticket.Id)">Open</button>
                                @if (CanDelete(ticket))
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTicketAsync(ticket.Id)">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private readonly List<Ticket> TicketItems = [];
    private IReadOnlyList<TicketCategory> Categories = [];
    private IReadOnlyList<UserSummary> AssignableAgents = [];
    private bool IsLoading = true;
    private bool IsCreating;
    private bool ShowCreateForm;
    private string? CurrentUserId;
    private bool IsRequester;
    private bool IsAgent;
    private bool IsAdmin;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private string SearchText = string.Empty;
    private string SelectedCategoryId = string.Empty;
    private string SelectedStatus = string.Empty;
    private string SelectedPriority = string.Empty;
    private string SelectedAssigneeUserId = string.Empty;
    private DateTime? UpdatedFrom;
    private DateTime? UpdatedTo;
    private TicketScope SelectedScope = TicketScope.MyRequested;
    private TicketDashboardSummary Dashboard = new(0, 0, 0, 0, 0, new Dictionary<TicketStatus, int>(), new Dictionary<TicketPriority, int>(), []);
    private CreateTicketModel CreateModel { get; set; } = new();

    private bool CanManageAll => IsAgent || IsAdmin;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            await LoadCurrentUserAsync();
            Categories = await TicketService.GetCategoriesAsync();
            AssignableAgents = CanManageAll ? await UserAdministrationService.GetAssignableAgentsAsync() : [];

            if (CreateModel.CategoryId == 0 && Categories.Count > 0)
            {
                CreateModel.CategoryId = Categories[0].Id;
            }

            Dashboard = await TicketService.GetDashboardAsync(CurrentUserId ?? string.Empty, IsAgent, IsAdmin);
            await LoadTicketsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load tickets: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadTicketsAsync()
    {
        var query = new TicketListQuery(
            SearchText,
            int.TryParse(SelectedCategoryId, out var categoryId) ? categoryId : null,
            Enum.TryParse<TicketStatus>(SelectedStatus, out var status) ? status : null,
            Enum.TryParse<TicketPriority>(SelectedPriority, out var priority) ? priority : null,
            SelectedAssigneeUserId == "__unassigned" ? string.Empty : SelectedAssigneeUserId,
            UpdatedFrom?.Date,
            UpdatedTo?.Date.AddDays(1).AddTicks(-1),
            SelectedScope == TicketScope.MyRequested,
            SelectedScope == TicketScope.MyAssigned);

        var items = await TicketService.GetVisibleAsync(query, CurrentUserId ?? string.Empty, IsAgent, IsAdmin);

        if (SelectedAssigneeUserId == "__unassigned")
        {
            items = items.Where(ticket => string.IsNullOrWhiteSpace(ticket.AssignedUserId)).ToList();
        }

        TicketItems.Clear();
        TicketItems.AddRange(items);
    }

    private async Task ApplyFiltersAsync() => await LoadPageAsync();

    private async Task ClearFiltersAsync()
    {
        SearchText = string.Empty;
        SelectedCategoryId = string.Empty;
        SelectedStatus = string.Empty;
        SelectedPriority = string.Empty;
        SelectedAssigneeUserId = string.Empty;
        UpdatedFrom = null;
        UpdatedTo = null;
        SelectedScope = CanManageAll ? TicketScope.All : TicketScope.MyRequested;
        await LoadPageAsync();
    }

    private async Task SetScopeAsync(TicketScope scope)
    {
        SelectedScope = scope;
        await LoadPageAsync();
    }

    private void ToggleCreateForm()
    {
        ShowCreateForm = !ShowCreateForm;
        SuccessMessage = null;
        ErrorMessage = null;

        if (ShowCreateForm && CreateModel.CategoryId == 0 && Categories.Count > 0)
        {
            CreateModel.CategoryId = Categories[0].Id;
        }
    }

    private async Task CreateTicketAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentUserId))
        {
            ErrorMessage = "A signed-in user is required to create tickets.";
            return;
        }

        IsCreating = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var created = await TicketService.CreateAsync(
                CreateModel.Title,
                CreateModel.Description,
                CreateModel.CategoryId,
                CreateModel.Priority,
                CurrentUserId);

            ShowCreateForm = false;
            CreateModel = new CreateTicketModel { CategoryId = Categories.FirstOrDefault()?.Id ?? 0 };
            SuccessMessage = $"Ticket #{created.Id} created successfully.";
            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to create ticket: {ex.Message}";
        }
        finally
        {
            IsCreating = false;
        }
    }

    private async Task DeleteTicketAsync(int ticketId)
    {
        if (string.IsNullOrWhiteSpace(CurrentUserId))
        {
            ErrorMessage = "A signed-in user is required.";
            return;
        }

        try
        {
            var deleted = await TicketService.SoftDeleteAsync(ticketId, CurrentUserId, IsAdmin);
            if (deleted)
            {
                SuccessMessage = $"Ticket #{ticketId} deleted.";
                await LoadPageAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private bool CanDelete(Ticket ticket)
        => IsAdmin || (ticket.RequesterUserId == CurrentUserId && ticket.Status == TicketStatus.New);

    private async Task LoadCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        CurrentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        IsRequester = user.IsInRole(ApplicationRoles.Requester);
        IsAgent = user.IsInRole(ApplicationRoles.Agent);
        IsAdmin = user.IsInRole(ApplicationRoles.Admin);

        if (!CanManageAll)
        {
            SelectedScope = TicketScope.MyRequested;
        }
    }

    private static string GetStatusBadgeClass(TicketStatus status)
        => status switch
        {
            TicketStatus.New => "bg-secondary",
            TicketStatus.Assigned => "bg-info text-dark",
            TicketStatus.InProgress => "bg-primary",
            TicketStatus.Resolved => "bg-success",
            TicketStatus.Closed => "bg-dark",
            _ => "bg-secondary"
        };

    private static string GetPriorityBadgeClass(TicketPriority priority)
        => priority switch
        {
            TicketPriority.Low => "bg-light text-dark",
            TicketPriority.Medium => "bg-secondary",
            TicketPriority.High => "bg-warning text-dark",
            TicketPriority.Critical => "bg-danger",
            _ => "bg-secondary"
        };

    private static string Truncate(string text, int maxLength)
        => text.Length <= maxLength ? text : $"{text[..maxLength]}...";

    private void NavigateToDetails(int ticketId)
    {
        NavigationManager.NavigateTo($"/tickets/{ticketId}");
    }

    private enum TicketScope
    {
        All,
        MyRequested,
        MyAssigned
    }

    private sealed class CreateTicketModel
    {
        [Required]
        [StringLength(200, MinimumLength = 3)]
        public string Title { get; set; } = string.Empty;

        [Required]
        [StringLength(4000, MinimumLength = 5)]
        public string Description { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Select a category.")]
        public int CategoryId { get; set; }

        public TicketPriority Priority { get; set; } = TicketPriority.Medium;
    }
}
